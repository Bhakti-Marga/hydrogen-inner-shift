# Local development environment for `make dev`.
# `make setup` copies this file to `.env` and fills in secrets.
# `.env` is gitignored; never commit real values.

# Signs session cookies. Required — the server refuses to start without it.
# Generate a new one with: openssl rand -hex 32
SESSION_SECRET=

# Relays the "Start a conversation" form to BhaktiHub. Server only: set it in
# .env locally and as an Oxygen environment variable in production. Never
# prefix it with PUBLIC_, or it would ship to the browser.
BHAKTIHUB_FORMS_API_KEY=
